#!/usr/bin/env bash
# SlawdCode — one-time OAuth authentication setup
# Linux / macOS / WSL2
#
# Run this once (or any time you need to re-authenticate). A browser window
# will open — sign in with your Anthropic account. OAuth tokens are saved to
# ~/.claude/ and ~/.claude.json on the HOST.
set -euo pipefail

IMAGE="${SLAWDCODE_IMAGE:-slawdcode:latest}"
RUNTIME="${SLAWDCODE_RUNTIME:-}"

if [ -z "$RUNTIME" ]; then
    if command -v podman &>/dev/null; then
        RUNTIME="podman"
    elif command -v docker &>/dev/null; then
        RUNTIME="docker"
    else
        echo "Error: neither podman nor docker found." >&2
        exit 1
    fi
fi

HOST_CONFIG="${HOME}/.claude"
HOST_SESSION="${HOME}/.claude.json"
HOST_CREDS="${HOST_CONFIG}/.credentials.json"

# M5: refuse to operate if any credential path is a symlink.
for _path in "$HOST_CONFIG" "$HOST_SESSION" "$HOST_CREDS"; do
    if [ -L "$_path" ]; then
        echo "Error: symlink detected at $_path — refusing to operate." >&2
        echo "  Remove the symlink; SlawdCode will recreate it as a regular file/directory." >&2
        exit 1
    fi
done

mkdir -p "$HOST_CONFIG"

# M3: reject EXTRA_ARGS that would undo container hardening.
_EXTRA_ARGS_DENIED='--privileged|--cap-add|--user[[:space:]=]+0|--user[[:space:]=]+root|--network[[:space:]=]+host|--pid[[:space:]=]+host|--ipc[[:space:]=]+host|--userns[[:space:]=]+host|--security-opt[[:space:]=]+seccomp=unconfined|--security-opt[[:space:]=]+apparmor=unconfined|--security-opt[[:space:]=]+label=disable'
if printf '%s' "${SLAWDCODE_EXTRA_ARGS:-}" | grep -qiE "${_EXTRA_ARGS_DENIED}"; then
    if [ "${SLAWDCODE_ALLOW_UNSAFE_EXTRA_ARGS:-}" = "1" ]; then
        echo "Warning: SLAWDCODE_ALLOW_UNSAFE_EXTRA_ARGS=1 — security-hardening bypass active." >&2
    else
        echo "Error: SLAWDCODE_EXTRA_ARGS contains a flag that undoes container hardening." >&2
        echo "  Set SLAWDCODE_ALLOW_UNSAFE_EXTRA_ARGS=1 to override (at your own risk)." >&2
        exit 1
    fi
fi

# --- Pre-auth: remove stale auth containers from previous failed runs ---
#
# When credential extraction fails, slawdcode-auth intentionally leaves the
# named container behind so the user can run 'podman cp' manually. On
# Windows / Podman Desktop these stopped containers can hold Podman's WSL2
# bridge in a degraded state that causes subsequent auth runs to also fail.
# Removing them here resets that state before every new attempt, eliminating
# the need to run 'make clean' just to get a working re-auth.
stale=$("$RUNTIME" ps -aq --filter "name=slawdcode-auth-" 2>/dev/null || true)
if [ -n "$stale" ]; then
    echo "Removing stale auth containers..." >&2
    # shellcheck disable=SC2086
    "$RUNTIME" rm -f $stale >/dev/null 2>&1 || true
fi

# Reset both credential files to clean '{}' placeholders before every auth run.
#
# This serves two purposes:
#
#  1. It clears any stale / expired session state so that the regular 'claude'
#     wrapper always has valid JSON files to bind-mount, even when auth fails.
#     The files are overwritten by 'podman cp' once auth succeeds.
#
#  2. It prevents stale data from influencing behaviour: previously the host
#     ~/.claude.json (containing an existing session reference) was
#     bind-mounted into the auth container. Claude Code would detect the
#     "existing session" and sometimes skip the OAuth browser redirect
#     entirely, leaving credentials empty. By resetting the file here and
#     NOT mounting it (see below), every auth run is a guaranteed clean-slate
#     OAuth flow.
(umask 077 && printf '{}\n' > "$HOST_SESSION")
(umask 077 && printf '{}\n' > "$HOST_CREDS")
chmod 600 "$HOST_CREDS"

echo "SlawdCode — Claude Code Authentication"
echo "======================================="
echo "A browser window will open. Sign in with your Anthropic account."
echo "Your credentials will be saved to:"
echo "  $HOST_CONFIG"
echo "  $HOST_SESSION"
echo "  $HOST_CREDS"
echo ""

# --- Why this script runs the auth container with NO volume mounts ---
#
# The auth container is intentionally started with no bind mounts so that:
#
#  a) Claude Code writes its OAuth tokens and session metadata entirely to
#     the container's own overlay filesystem (ext4 inside the WSL2 VM on
#     Windows). There is no WSL2 → 9p → NTFS boundary for the
#     atomic-rename write to fail across.
#
#  b) 'podman cp' reads from that same overlay, not through a bind mount.
#     When ~/.claude.json was bind-mounted, 'podman cp' would read through
#     the mount back to the host file, returning the stale placeholder
#     instead of the freshly-written session file.
#
#  c) Every re-auth is a guaranteed clean-slate OAuth flow. A stale or
#     expired ~/.claude.json on the host can cause Claude Code to detect
#     an "existing session" and skip the browser redirect, leaving the
#     credentials file empty. With no mounts, that can't happen.
AUTH_CONTAINER="slawdcode-auth-$$-$(date +%s 2>/dev/null || echo $RANDOM)"

cleanup() {
    "$RUNTIME" rm -f "$AUTH_CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

case "${SLAWDCODE_DEBUG:-}" in
    1|true|TRUE|yes|YES)
        {
            echo "--- SlawdCode debug ---"
            echo "Runtime:        $RUNTIME"
            echo "Image:          $IMAGE"
            echo "AuthContainer:  $AUTH_CONTAINER"
            echo "HostConfig:     $HOST_CONFIG"
            echo "HostSession:    $HOST_SESSION"
            echo "HostCreds:      $HOST_CREDS"
            echo "Strategy:       no mounts; named container + '$RUNTIME cp' both files after auth"
            echo "-----------------------"
        } >&2
        ;;
esac

# Run auth in a named, non-rm container with NO volume mounts (see above).
auth_status=0
"$RUNTIME" run \
    --interactive \
    --tty \
    --name "$AUTH_CONTAINER" \
    --security-opt no-new-privileges \
    --cap-drop ALL \
    ${SLAWDCODE_EXTRA_ARGS:-} \
    "$IMAGE" \
    auth login || auth_status=$?

# Extract credentials from the now-stopped container. Capture stderr so any
# failure is visible and diagnosable.
extract_status=0
cp_output=$("$RUNTIME" cp \
    "${AUTH_CONTAINER}:/home/claude/.claude/.credentials.json" \
    "$HOST_CREDS" 2>&1) || extract_status=$?

if [ "$extract_status" -ne 0 ] || [ ! -s "$HOST_CREDS" ] || [ "$(wc -c < "$HOST_CREDS")" -le 3 ]; then
    echo "" >&2
    echo "Warning: '$RUNTIME cp' did not deliver .credentials.json to the host." >&2
    if [ -n "$cp_output" ]; then
        echo "         Last output: $cp_output" >&2
    fi
    echo "         Recovery options:" >&2
    echo "           1. Re-run slawdcode-auth — stale containers are pre-cleaned automatically." >&2
    echo "           2. Manually extract:" >&2
    echo "                $RUNTIME cp '${AUTH_CONTAINER}:/home/claude/.claude/.credentials.json' '$HOST_CREDS'" >&2
    echo "              (the named container is left in place when extraction fails)." >&2
    echo "           3. Bypass OAuth entirely by setting ANTHROPIC_API_KEY before running 'claude'." >&2
    echo "              See the README 'Authentication / Fallback: API key' section." >&2

    if [ ! -s "$HOST_CREDS" ]; then
        (umask 077 && printf '{}\n' > "$HOST_CREDS")
    fi

    extraction_failed=1
else
    extraction_failed=0
fi
chmod 600 "$HOST_CREDS" 2>/dev/null || true

# Extract ~/.claude.json — since we no longer bind-mount it, Claude Code
# creates a fresh version in the container overlay. We must always cp it
# out; otherwise the host file stays at the '{}' placeholder and the
# regular 'claude' wrapper starts each session without user/org identity.
"$RUNTIME" cp \
    "${AUTH_CONTAINER}:/home/claude/.claude.json" \
    "$HOST_SESSION" 2>/dev/null || true

# Leave the named container in place only when extraction failed — the user
# can then recover by running 'podman cp' manually.
if [ "${extraction_failed:-0}" -eq 0 ]; then
    trap - EXIT
    cleanup
else
    trap - EXIT INT TERM
    echo "" >&2
    echo "The auth container '$AUTH_CONTAINER' has been left in place so you can inspect or extract its contents." >&2
    echo "Remove it manually when done: $RUNTIME rm -f $AUTH_CONTAINER" >&2
fi

exit "$auth_status"
