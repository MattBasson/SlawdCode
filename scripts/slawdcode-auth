#!/usr/bin/env bash
# SlawdCode — one-time OAuth authentication setup
# Linux / macOS / WSL2
#
# Run this once. A browser window will open — sign in with your Anthropic account.
# OAuth tokens are saved to ~/.claude/ and ~/.claude.json on the HOST.
set -euo pipefail

IMAGE="${SLAWDCODE_IMAGE:-slawdcode:latest}"
RUNTIME="${SLAWDCODE_RUNTIME:-}"

if [ -z "$RUNTIME" ]; then
    if command -v podman &>/dev/null; then
        RUNTIME="podman"
    elif command -v docker &>/dev/null; then
        RUNTIME="docker"
    else
        echo "Error: neither podman nor docker found." >&2
        exit 1
    fi
fi

HOST_CONFIG="${HOME}/.claude"
HOST_SESSION="${HOME}/.claude.json"
HOST_CREDS="${HOST_CONFIG}/.credentials.json"
mkdir -p "$HOST_CONFIG"

# Initialize ~/.claude.json with '{}' (valid empty-object JSON) — Claude
# Code parses it on startup and refuses to run on invalid JSON.
if [ ! -s "$HOST_SESSION" ]; then
    (umask 077 && printf '{}\n' > "$HOST_SESSION")
fi
# Initialize ~/.claude/.credentials.json similarly. We do NOT bind-mount
# this file (see below); it just needs to exist so subsequent 'claude'
# runs that DO bind-mount it have a real file source.
if [ ! -s "$HOST_CREDS" ]; then
    (umask 077 && printf '{}\n' > "$HOST_CREDS")
fi
chmod 600 "$HOST_CREDS" 2>/dev/null || true

echo "SlawdCode — Claude Code Authentication"
echo "======================================="
echo "A browser window will open. Sign in with your Anthropic account."
echo "Your credentials will be saved to:"
echo "  $HOST_CONFIG"
echo "  $HOST_SESSION"
echo "  $HOST_CREDS"
echo ""

# --- Why this script avoids --rm + a bind mount for .credentials.json ---
#
# Claude Code writes its OAuth access/refresh tokens to
# /home/claude/.claude/.credentials.json (mode 0600). On Podman-Desktop /
# Docker-Desktop on Windows, this write does not reach the host through
# either a directory bind mount (file is silently dropped when created at
# the root of the mount) or a single-file bind mount (the atomic-rename
# pattern Claude Code uses fails across the WSL2 → 9p → NTFS boundary,
# so the rename never lands).
#
# Both failure modes are silent — "Login successful" prints, but the
# host-side file stays at the 2-byte '{}' placeholder.
#
# We work around this by running 'claude auth login' in a NAMED (not
# --rm) container, then extracting the credentials file with the
# runtime's own 'cp' subcommand. 'podman cp' / 'docker cp' goes through
# a different file-extraction path than bind mounts and does land bytes
# on the host. The container is then removed.
AUTH_CONTAINER="slawdcode-auth-$$-$(date +%s 2>/dev/null || echo $RANDOM)"

cleanup() {
    "$RUNTIME" rm -f "$AUTH_CONTAINER" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

case "${SLAWDCODE_DEBUG:-}" in
    1|true|TRUE|yes|YES)
        {
            echo "--- SlawdCode debug ---"
            echo "Runtime:        $RUNTIME"
            echo "Image:          $IMAGE"
            echo "AuthContainer:  $AUTH_CONTAINER"
            echo "HostConfig:     $HOST_CONFIG"
            echo "HostSession:    $HOST_SESSION"
            echo "HostCreds:      $HOST_CREDS"
            echo "Strategy:       run named container + '$RUNTIME cp' the creds file out after auth"
            echo "-----------------------"
        } >&2
        ;;
esac

# Run auth in a named, non-rm container.
# The ~/.claude/ directory and ~/.claude.json are still bind-mounted so
# in-progress changes Claude Code makes during the auth flow (history,
# settings, the session payload in ~/.claude.json itself) persist
# directly — only the credentials file needs the cp workaround.
auth_status=0
"$RUNTIME" run \
    --interactive \
    --tty \
    --name "$AUTH_CONTAINER" \
    --volume "${HOST_CONFIG}:/home/claude/.claude:z" \
    --volume "${HOST_SESSION}:/home/claude/.claude.json:z" \
    --security-opt no-new-privileges \
    --cap-drop ALL \
    ${SLAWDCODE_EXTRA_ARGS:-} \
    "$IMAGE" \
    auth login || auth_status=$?

# Extract the credentials file from the now-stopped container. Capture
# both stdout and stderr so failures (especially on Podman Desktop /
# Windows where 'podman cp' can behave unexpectedly) are visible.
extract_status=0
cp_output=$("$RUNTIME" cp \
    "${AUTH_CONTAINER}:/home/claude/.claude/.credentials.json" \
    "$HOST_CREDS" 2>&1) || extract_status=$?

if [ "$extract_status" -ne 0 ] || [ ! -s "$HOST_CREDS" ] || [ "$(wc -c < "$HOST_CREDS")" -le 3 ]; then
    echo "" >&2
    echo "Warning: '$RUNTIME cp' did not deliver .credentials.json to the host." >&2
    if [ -n "$cp_output" ]; then
        echo "         Last output: $cp_output" >&2
    fi
    echo "         Recovery options:" >&2
    echo "           1. Re-run slawdcode-auth (transient errors usually clear)." >&2
    echo "           2. Manually extract:" >&2
    echo "                $RUNTIME cp '${AUTH_CONTAINER}:/home/claude/.claude/.credentials.json' '$HOST_CREDS'" >&2
    echo "              (the named container is left in place when extraction fails)." >&2
    echo "           3. Bypass OAuth entirely by setting ANTHROPIC_API_KEY before running 'claude'." >&2
    echo "              See the README 'Authentication / Fallback: API key' section." >&2

    # Restore the placeholder so the regular 'claude' wrapper has a
    # file source for its bind mount.
    if [ ! -s "$HOST_CREDS" ]; then
        (umask 077 && printf '{}\n' > "$HOST_CREDS")
    fi

    extraction_failed=1
else
    extraction_failed=0
fi
chmod 600 "$HOST_CREDS" 2>/dev/null || true

# Belt-and-suspenders fallback for ~/.claude.json
host_session_size=$(wc -c < "$HOST_SESSION" 2>/dev/null || echo 0)
if [ "$host_session_size" -le 3 ]; then
    "$RUNTIME" cp \
        "${AUTH_CONTAINER}:/home/claude/.claude.json" \
        "$HOST_SESSION" 2>/dev/null || true
fi

# Leave the named container in place when extraction failed so the user
# can recover by running 'podman cp' themselves; remove it on success.
if [ "${extraction_failed:-0}" -eq 0 ]; then
    trap - EXIT
    cleanup
else
    trap - EXIT INT TERM
    echo "" >&2
    echo "The auth container '$AUTH_CONTAINER' has been left in place so you can inspect or extract its contents." >&2
    echo "Remove it manually when done: $RUNTIME rm -f $AUTH_CONTAINER" >&2
fi

exit "$auth_status"
