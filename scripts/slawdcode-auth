#!/usr/bin/env bash
# SlawdCode — one-time OAuth authentication setup
# Linux / macOS / WSL2
#
# Run this once. A browser window will open — sign in with your Anthropic account.
# OAuth tokens are saved to ~/.claude/ on the HOST machine (never inside the container).
# After this, you can run 'claude' without any API key.
set -euo pipefail

IMAGE="${SLAWDCODE_IMAGE:-slawdcode:latest}"
RUNTIME="${SLAWDCODE_RUNTIME:-}"

if [ -z "$RUNTIME" ]; then
    if command -v podman &>/dev/null; then
        RUNTIME="podman"
    elif command -v docker &>/dev/null; then
        RUNTIME="docker"
    else
        echo "Error: neither podman nor docker found." >&2
        exit 1
    fi
fi

HOST_CONFIG="${HOME}/.claude"
HOST_SESSION="${HOME}/.claude.json"
mkdir -p "$HOST_CONFIG"
# Bind-mounting a single file requires the source to exist. Recent Claude
# Code releases store the OAuth login state in ~/.claude.json (not inside
# the ~/.claude/ directory), so without this file mount the token is
# written to a path inside the --rm container and lost on exit.
# Initialize with '{}' (valid empty-object JSON) rather than a zero-byte
# file: Claude Code parses ~/.claude.json on startup and refuses to run if
# the file isn't valid JSON, so a 0-byte placeholder triggers a
# "Configuration Error / Unexpected EOF" prompt before the auth flow
# can begin.
if [ ! -s "$HOST_SESSION" ]; then
    (umask 077 && printf '{}\n' > "$HOST_SESSION")
fi

echo "SlawdCode — Claude Code Authentication"
echo "======================================="
echo "A browser window will open. Sign in with your Anthropic account."
echo "Your credentials will be saved to:"
echo "  $HOST_CONFIG"
echo "  $HOST_SESSION"
echo ""

case "${SLAWDCODE_DEBUG:-}" in
    1|true|TRUE|yes|YES)
        {
            echo "--- SlawdCode debug ---"
            echo "Runtime:      $RUNTIME"
            echo "Image:        $IMAGE"
            echo "HostConfig:   $HOST_CONFIG"
            echo "HostSession:  $HOST_SESSION"
            echo "-----------------------"
        } >&2
        ;;
esac

exec "$RUNTIME" run \
    --rm \
    --interactive \
    --tty \
    --volume "${HOST_CONFIG}:/home/claude/.claude:z" \
    --volume "${HOST_SESSION}:/home/claude/.claude.json:z" \
    --security-opt no-new-privileges \
    --cap-drop ALL \
    ${SLAWDCODE_EXTRA_ARGS:-} \
    "$IMAGE" \
    auth login
