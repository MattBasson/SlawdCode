#!/usr/bin/env bash
# SlawdCode — run Claude Code securely in a rootless container
# Linux / macOS / WSL2 wrapper
set -euo pipefail

# --- Configuration ---
IMAGE="${SLAWDCODE_IMAGE:-slawdcode:latest}"
RUNTIME="${SLAWDCODE_RUNTIME:-}"

# L11: soft warning if SLAWDCODE_IMAGE looks like it came from an unexpected registry.
case "$IMAGE" in
    slawdcode:*|slawdcode@*) ;;
    *)
        echo "Warning: SLAWDCODE_IMAGE='$IMAGE' does not start with 'slawdcode/' — using a custom image." >&2
        ;;
esac

# Auto-detect container runtime (prefer podman for rootless operation)
if [ -z "$RUNTIME" ]; then
    if command -v podman &>/dev/null; then
        RUNTIME="podman"
    elif command -v docker &>/dev/null; then
        RUNTIME="docker"
    else
        echo "Error: neither podman nor docker found." >&2
        echo "  Linux/macOS: install Podman  https://podman.io/getting-started/installation" >&2
        echo "  Windows:     install Podman Desktop or Docker Desktop" >&2
        exit 1
    fi
fi

# --- Volume mounts ---
# $PWD                       → /workspace                              (your project)
# ~/.claude                  → /home/claude/.claude                    (project history, MCP config, etc.)
# ~/.claude.json             → /home/claude/.claude.json               (session metadata)
# ~/.claude/.credentials.json→ /home/claude/.claude/.credentials.json  (OAuth tokens — see below)
HOST_CWD="$(pwd)"
HOST_CONFIG="${HOME}/.claude"
HOST_SESSION="${HOME}/.claude.json"
HOST_CREDS="${HOST_CONFIG}/.credentials.json"
mkdir -p "$HOST_CONFIG"

# Bind-mounting a single file requires the source to exist; create it on
# first run (or when the host file is empty / corrupt) so the OAuth tokens
# that 'claude auth login' writes here are persisted back to the host
# instead of being lost when the --rm container exits.
#
# Initialize with '{}' rather than a zero-byte file: current Claude Code
# parses ~/.claude.json on startup and refuses to run if it isn't valid
# JSON, so a 0-byte placeholder triggers a "Configuration Error /
# Unexpected EOF" prompt before the auth flow can even begin.
if [ ! -s "$HOST_SESSION" ]; then
    (umask 077 && printf '{}\n' > "$HOST_SESSION")
fi

# Separately bind-mount ~/.claude/.credentials.json — this is where Claude
# Code stores the OAuth access/refresh tokens. On Podman-Desktop /
# Docker-Desktop on Windows, brand-new files created at the root of a
# directory bind mount over the WSL2→9p→NTFS path do not reliably reach
# the host (existing files update fine, files in subdirs work fine, but a
# new mode-0600 file at the mount root is silently dropped). Pre-creating
# the host file and bind-mounting it directly forces it through the
# single-file mount code path, the same one that already works for
# ~/.claude.json.
if [ ! -s "$HOST_CREDS" ]; then
    (umask 077 && printf '{}\n' > "$HOST_CREDS")
fi
chmod 600 "$HOST_CREDS" 2>/dev/null || true

VOLUME_ARGS=(
    --volume "${HOST_CWD}:/workspace:z"
    --volume "${HOST_CONFIG}:/home/claude/.claude:z"
    --volume "${HOST_SESSION}:/home/claude/.claude.json:z"
    --volume "${HOST_CREDS}:/home/claude/.claude/.credentials.json:z"
)

# --- Optional: cloud CLI credential persistence ---
# When SLAWDCODE_PERSIST_CLOUD_CREDS is truthy, also mount the host config
# directories for the bundled cloud CLIs (gh, aws, az) so authentication
# survives across `claude` invocations. The directories are created on the
# host if they do not already exist.
case "${SLAWDCODE_PERSIST_CLOUD_CREDS:-}" in
    1|true|TRUE|yes|YES)
        for spec in \
            "${HOME}/.config/gh:/home/claude/.config/gh" \
            "${HOME}/.aws:/home/claude/.aws" \
            "${HOME}/.azure:/home/claude/.azure"
        do
            host_dir="${spec%%:*}"
            mkdir -p "$host_dir"
            VOLUME_ARGS+=(--volume "${spec}:z")
        done
        ;;
esac

# --- Authentication ---
# Preferred: OAuth tokens in ~/.claude (run 'slawdcode-auth' once to set up)
# Fallback:  ANTHROPIC_API_KEY env var (for CI / automation only)
ENV_ARGS=()
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    ENV_ARGS+=(--env "ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}")
fi

# --- Optional debug ---
# SLAWDCODE_DEBUG=1 prints the resolved host paths and the full runtime
# command before executing — useful when troubleshooting "auth doesn't
# persist" issues.
case "${SLAWDCODE_DEBUG:-}" in
    1|true|TRUE|yes|YES)
        {
            echo "--- SlawdCode debug ---"
            echo "Runtime:      $RUNTIME"
            echo "Image:        $IMAGE"
            echo "HostCwd:      $HOST_CWD"
            echo "HostConfig:   $HOST_CONFIG"
            echo "HostSession:  $HOST_SESSION"
            if [ -f "$HOST_SESSION" ]; then
                echo "HostSession size: $(wc -c < "$HOST_SESSION") bytes, modified: $(date -r "$HOST_SESSION" 2>/dev/null || stat -f '%Sm' "$HOST_SESSION" 2>/dev/null)"
            fi
            echo "HostCreds:    $HOST_CREDS"
            if [ -f "$HOST_CREDS" ]; then
                echo "HostCreds size:   $(wc -c < "$HOST_CREDS") bytes, modified: $(date -r "$HOST_CREDS" 2>/dev/null || stat -f '%Sm' "$HOST_CREDS" 2>/dev/null)"
            fi
            echo "Command:"
            echo "  $RUNTIME run --rm --interactive --tty ${ENV_ARGS[*]} ${VOLUME_ARGS[*]} --workdir /workspace --security-opt no-new-privileges --cap-drop ALL ${SLAWDCODE_EXTRA_ARGS:-} $IMAGE $*"
            echo "-----------------------"
        } >&2
        ;;
esac

# --- L4: Resource limits ---
# Default to sane caps; override or disable with SLAWDCODE_PIDS_LIMIT / SLAWDCODE_MEMORY.
# Set either to 'none' to remove the limit entirely.
_PIDS_LIMIT="${SLAWDCODE_PIDS_LIMIT:-512}"
_MEMORY="${SLAWDCODE_MEMORY:-4g}"
RESOURCE_ARGS=()
[ "$_PIDS_LIMIT" != "none" ] && RESOURCE_ARGS+=(--pids-limit "$_PIDS_LIMIT")
[ "$_MEMORY"     != "none" ] && RESOURCE_ARGS+=(--memory "$_MEMORY")

# --- L5: Read-only rootfs (opt-in) ---
# Set SLAWDCODE_READONLY_ROOTFS=1 to make the container rootfs read-only and
# overlay writable tmpfs mounts on /tmp and /home/claude/.cache.
ROOTFS_ARGS=()
case "${SLAWDCODE_READONLY_ROOTFS:-}" in
    1|true|TRUE|yes|YES)
        ROOTFS_ARGS+=(
            --read-only
            --tmpfs /tmp:mode=1777
            --tmpfs /home/claude/.cache:mode=0700
        )
        ;;
esac

# --- Run ---
exec "$RUNTIME" run \
    --rm \
    --interactive \
    --tty \
    "${ENV_ARGS[@]}" \
    "${VOLUME_ARGS[@]}" \
    "${RESOURCE_ARGS[@]}" \
    "${ROOTFS_ARGS[@]}" \
    --workdir /workspace \
    --security-opt no-new-privileges \
    --cap-drop ALL \
    ${SLAWDCODE_EXTRA_ARGS:-} \
    "$IMAGE" \
    "$@"
